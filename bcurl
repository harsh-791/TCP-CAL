#!/bin/sh
# Launch the binary client: ./bcurl -v localhost:9000/index.html
set -eu
BASE=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
pick_python() {
  for cand in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import sys" >/dev/null 2>&1; then
      echo "$cand"
      return 0
    fi
  done
  for cand in "$HOME"/.local/share/uv/python/cpython-3.*/bin/python3.*; do
    if [ -x "$cand" ] && "$cand" -c "import sys" >/dev/null 2>&1; then
      echo "$cand"
      return 0
    fi
  done
  return 1
}
PY=$(pick_python) || {
  echo "A working python3 is required." >&2
  exit 1
}
exec "$PY" "$BASE/bcurl.py" "$@"
